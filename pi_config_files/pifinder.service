[Unit]
Description=PiFinder
After=basic.target

[Service]
Type=idle
User=pifinder
WorkingDirectory=/home/pifinder/PiFinder/python
ExecStart=/usr/bin/python -m PiFinder.main --keyboard touch --display hyperpixel4_native --imu usb
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=basic.target
